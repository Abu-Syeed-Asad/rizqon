
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
# Pulled by neon deploy. Use the direct URL for Prisma migrations.
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/mydb"
NEON_AUTH_BASE_URL="https://your-branch.neonauth.region.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://your-branch.neonauth.region.aws.neon.tech/neondb/auth/.well-known/jwks.json"
NODE_ENV=development
PORT=5000
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=replace-with-a-secret-at-least-32-characters-long
FRONTEND_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional application mail only. Configure authentication email in Neon.
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
MAIL_FROM="RIZQON <no-reply@example.com>"
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password

# Hosted sale payments. Credentials remain on the server.
# Business IDs explicitly authorized to collect into these merchant accounts.
# PAYMENT_BUSINESS_IDS=business-id
# PAYMENT_PUBLIC_BASE_URL=https://api.example.com
# PAYMENT_RETURN_URL=https://app.example.com/payments/result
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# SSLCOMMERZ_STORE_ID=your-sandbox-store-id
# SSLCOMMERZ_STORE_PASSWORD=your-sandbox-store-password
SSLCOMMERZ_SANDBOX=true
