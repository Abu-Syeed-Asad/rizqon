{
  "info": {
    "name": "Rizqon Partner Commission Management",
    "description": "Request templates; choose appropriate transitions, do not run the entire collection as one sequence. Agreement draft edits precede activation. Deactivation/expiry, return rejection, settlement cancellation and failed payment reconciliation are alternative paths. Create a trusted draft sale separately. Manual reconciliation records independently verified evidence; no request executes an external transfer. Amounts are strings. All outstanding negative entries must be included in settlements.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "businessId",
      "value": ""
    },
    {
      "key": "partnerId",
      "value": ""
    },
    {
      "key": "variantId",
      "value": ""
    },
    {
      "key": "agreementId",
      "value": ""
    },
    {
      "key": "saleId",
      "value": ""
    },
    {
      "key": "saleItemId",
      "value": ""
    },
    {
      "key": "entryId",
      "value": ""
    },
    {
      "key": "returnId",
      "value": ""
    },
    {
      "key": "settlementId",
      "value": ""
    },
    {
      "key": "paymentId",
      "value": ""
    },
    {
      "key": "runKey",
      "value": "20261118-001"
    }
  ],
  "item": [
    {
      "name": "Create agreement draft",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/business/{{businessId}}/commission-agreements",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"partnerId\": \"{{partnerId}}\",\n  \"commissionPercent\": \"10.00\",\n  \"startsAt\": \"2026-11-18T00:00:00.000Z\",\n  \"endsAt\": null,\n  \"productVariantIds\": [\n    \"{{variantId}}\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [
        {
          "name": "Example success (illustrative)",
          "status": "Created",
          "code": 201,
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"success\": true,\n  \"message\": \"Create agreement draft\",\n  \"data\": {\n    \"id\": \"agreement_001\",\n    \"isActive\": false,\n    \"firstActivatedAt\": null,\n    \"commissionPercent\": \"10\"\n  }\n}"
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code < 300) { const result = pm.response.json(); if (result.data?.id) pm.collectionVariables.set(\"agreementId\", result.data.id); }"
            ]
          }
        }
      ]
    },
