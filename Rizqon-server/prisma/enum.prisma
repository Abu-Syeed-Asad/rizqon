// Shared PostgreSQL enums. Prisma identifiers are uppercase; @@map preserves existing database enum names.

enum USER_ROLE {
  OWNER
  CEO
  MANAGER
  BRANCH_MANAGER
  PRODUCT_MANAGER
  SECURITY
  SELLER
  ACCOUNTANT
  SELLER_COMPANY_ADMIN
  USER
  @@schema("commerce")
  @@map("role_code")
}
 enum SYSTEM_USER_ROLE {
RIZQON_OWNER
RIZQON_CEO
RIZQON_MANAGER
RIZQON_BRANCH_MANAGER
RIZQON_PRODUCT_MANAGER
RIZQON_OFFICE_STAFF
RIZQON_SELLER
RIZQON_ACCOUNTANT
RIZQON_USER

  @@schema("commerce")
}
enum STATUS {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED

  @@schema("commerce")
}
enum PAYMENT_METHOD_TYPE {
  CARD
  MOBILE_FINANCIAL_SERVICE
  BANK_TRANSFER
  CASH
  @@schema("commerce")
