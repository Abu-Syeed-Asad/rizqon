model StockMovement {
  id          String            @id @default(cuid())
  businessId  String
  delta       Decimal           @db.Decimal(18, 3)
  kind        STOCK_MOVEMENT_TYPE
  sourceType  String
  sourceId    String
  eventKey    String
  note        String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt()
  business    Business          @relation("StockMovement_business", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  inventoryId String
  inventory   Inventory         @relation("StockMovement_inventory", fields: [businessId, inventoryId], references: [businessId, id], onDelete: Restrict, onUpdate: NoAction)
  actorId     String
  actor       Employee          @relation("StockMovement_actor", fields: [businessId, actorId], references: [businessId, Employee_id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([businessId, id])
  @@unique([businessId, eventKey])
  @@index([businessId])
  @@index([businessId, inventoryId])
  @@index([businessId, actorId])
  @@schema("commerce")
}
