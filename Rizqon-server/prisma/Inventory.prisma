model Inventory {
  id                      String          @id @default(cuid())
  businessId              String
  quantity                Decimal         @default(0) @db.Decimal(18, 3)
  reinstall_alert_level   Decimal         @default(0) @db.Decimal(18, 3) // if quantity <= reinstall_alert_level, then the inventory is low and needs to be reordered
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt()
  business                Business        @relation("Inventory_business", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  branchId                String
  branch                  Branch          @relation("Inventory_branch", fields: [businessId, branchId], references: [businessId, id], onDelete: Restrict, onUpdate: NoAction)
  variantId               String
  variant                 ProductVariant  @relation("Inventory_variant", fields: [businessId, variantId], references: [businessId, id], onDelete: Restrict, onUpdate: NoAction)
  stockMovement_inventory StockMovement[] @relation("StockMovement_inventory")

  @@unique([businessId, id])
  @@unique([businessId, branchId, variantId])
  @@index([businessId])
  @@index([businessId, branchId])
  @@index([businessId, variantId])
  @@schema("commerce")
}
