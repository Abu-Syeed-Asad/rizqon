model Notification {
  id          String           @id @default(cuid())
  businessId  String
  type        NOTIFICATION_TYPE
  title       String
  message     String
  entityType  String?
  entityId    String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt()
  business    Business         @relation("Notification_business", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  recipientId String
  recipient   User             @relation("Notification_recipient", fields: [recipientId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([businessId, id])
  @@index([businessId])
  @@index([recipientId])
  @@schema("commerce")
}
