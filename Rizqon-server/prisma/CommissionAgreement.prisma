model CommissionAgreement {
  id                        String            @id @default(cuid())
  businessId                String
  business_name             String
  commissionPercent         Decimal           @db.Decimal(5, 2)
  startsAt                  DateTime          @default(now())
  endsAt                    DateTime?
  isActive                  Boolean           @default(true)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt()
  business                  Business          @relation("CommissionAgreement_business", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  productVariant_agreement  ProductVariant[]  @relation("ProductVariant_agreement")
  partnerId                 String
  partner                   Partner           @relation("CommissionAgreement_partner", fields: [businessId, partnerId], references: [businessId, id], onDelete: Restrict, onUpdate: NoAction)
  saleItem_agreement        SaleItem[]        @relation("SaleItem_agreement")
  commissionEntry_agreement CommissionEntry[] @relation("CommissionEntry_agreement")

  @@unique([businessId, id])
  @@index([businessId])
  @@index([businessId, partnerId])
  @@schema("commerce")
}
