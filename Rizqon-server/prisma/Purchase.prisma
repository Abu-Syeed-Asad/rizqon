model Purchase {
  id                    String         @id @default(cuid())
  businessId            String
  invoiceNumber         String
  supplierInvoiceNumber String?
  status                PURCHASE_STATUS @default(DRAFT)
  currency              String         @default("BDT")
  totalAmount           Decimal        @db.Decimal(18, 2)
  receivedAt            DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt()
  business              Business       @relation("Purchase_business", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  branchId              String
  branch                Branch         @relation("Purchase_branch", fields: [businessId, branchId], references: [businessId, id], onDelete: Restrict, onUpdate: NoAction)
  supplierId            String
  supplier              Partner        @relation("Purchase_supplier", fields: [businessId, supplierId], references: [businessId, id], onDelete: Restrict, onUpdate: NoAction)
  creatorId             String
  creator               Employee       @relation("Purchase_creator", fields: [businessId, creatorId], references: [businessId, Employee_id], onDelete: Restrict, onUpdate: NoAction)
  purchaseItem_purchase PurchaseItem[] @relation("PurchaseItem_purchase")
  payment_purchase      Payment[]      @relation("Payment_purchase")

  @@unique([businessId, id])
  @@unique([businessId, invoiceNumber])
  @@index([businessId])
  @@index([businessId, branchId])
  @@index([businessId, supplierId])
  @@index([businessId, creatorId])
  @@schema("commerce")
}
