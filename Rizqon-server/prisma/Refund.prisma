model Refund {
  id                  String         @id @default(cuid())
  businessId          String
  amount              Decimal        @db.Decimal(18, 2)
  method              PAYMENT_METHOD
  status              PAYMENT_STATUS  @default(PENDING)
  idempotencyKey      String
  provider            String?
  providerReference   String?
  completedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt()
  business            Business       @relation("Refund_business", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  paymentEvent_refund PaymentEvent[] @relation("PaymentEvent_refund")
  paymentId           String
  payment             Payment        @relation("Refund_payment", fields: [businessId, paymentId], references: [businessId, id], onDelete: Restrict, onUpdate: NoAction)
  saleReturnId        String
  saleReturn          SaleReturn     @relation("Refund_saleReturn", fields: [businessId, saleReturnId], references: [businessId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([businessId, id])
  @@unique([businessId, idempotencyKey])
  @@unique([provider, providerReference])
  @@index([businessId])
  @@index([businessId, paymentId])
  @@index([businessId, saleReturnId])
  @@schema("commerce")
}
