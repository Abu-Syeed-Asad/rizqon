// Delivery and returns models.

model Carrier {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  name String
  integration_type String
  status String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_tenant_id Tenant @relation("Carrier_tenant_id", fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_carrier_tenant_id")
  back_CodRemittance_carrier_id CodRemittance[] @relation("CodRemittance_carrier_id")
  back_Shipment_carrier_id Shipment[] @relation("Shipment_carrier_id")
  @@unique([tenant_id, id])
  @@map("carrier")
  @@schema("commerce")
}

model Shipment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  order_id String @db.Uuid
  carrier_id String? @db.Uuid
  origin_id String @db.Uuid
  tracking_number String
  status String
  shipping_address_snapshot Json @db.JsonB
  packed_by String? @db.Uuid
  packed_at DateTime? @db.Timestamptz(6)
  shipped_at DateTime? @db.Timestamptz(6)
  delivered_at DateTime? @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_tenant_id Tenant @relation("Shipment_tenant_id", fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_shipment_tenant_id")
  ref_order_id Order @relation("Shipment_order_id", fields: [tenant_id, order_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_shipment_order_id")
  ref_carrier_id Carrier? @relation("Shipment_carrier_id", fields: [tenant_id, carrier_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_shipment_carrier_id")
  ref_origin_id Location @relation("Shipment_origin_id", fields: [tenant_id, origin_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_shipment_origin_id")
  ref_packed_by TenantMembership? @relation("Shipment_packed_by", fields: [tenant_id, packed_by], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_shipment_packed_by")
  back_CodCollection_shipment_id CodCollection[] @relation("CodCollection_shipment_id")
  back_ShipmentItem_shipment_id ShipmentItem[] @relation("ShipmentItem_shipment_id")
  back_ShipmentEvent_shipment_id ShipmentEvent[] @relation("ShipmentEvent_shipment_id")
  back_DeliveryProof_shipment_id DeliveryProof[] @relation("DeliveryProof_shipment_id")
  @@unique([tenant_id, id])
  @@map("shipment")
  @@schema("commerce")
}

