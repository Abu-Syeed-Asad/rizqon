// Inventory models.

model InventoryBalance {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  variant_id String @db.Uuid
  location_id String @db.Uuid
  lot_id String? @db.Uuid
  on_hand Decimal @db.Decimal(20,6) @default(0)
  reserved Decimal @db.Decimal(20,6) @default(0)
  version Int @default(1)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  ref_tenant_id Tenant @relation("InventoryBalance_tenant_id", fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_inventory_balance_tenant_id")
  ref_variant_id ProductVariant @relation("InventoryBalance_variant_id", fields: [tenant_id, variant_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_inventory_balance_variant_id")
  ref_location_id Location @relation("InventoryBalance_location_id", fields: [tenant_id, location_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_inventory_balance_location_id")
  ref_lot_id InventoryLot? @relation("InventoryBalance_lot_id", fields: [tenant_id, lot_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_inventory_balance_lot_id")
  @@unique([tenant_id, id])
  @@unique([tenant_id, variant_id, location_id, lot_id])
  @@map("inventory_balance")
  @@schema("commerce")
}

