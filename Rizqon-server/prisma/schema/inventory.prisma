  ref_performed_by TenantMembership? @relation("StockMovement_performed_by", fields: [tenant_id, performed_by], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_stock_movement_performed_by")
  back_InventoryCostAllocation_movement_id InventoryCostAllocation[] @relation("InventoryCostAllocation_movement_id")
  @@unique([tenant_id, id])
  @@map("stock_movement")
  @@schema("commerce")
}

