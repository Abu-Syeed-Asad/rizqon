model InventoryLot {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  variant_id String @db.Uuid
  lot_number String
  expires_at DateTime? @db.Timestamptz(6)
  unit_cost Decimal @db.Decimal(20,4)
  manufactured_at DateTime? @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_tenant_id Tenant @relation("InventoryLot_tenant_id", fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_inventory_lot_tenant_id")
  ref_variant_id ProductVariant @relation("InventoryLot_variant_id", fields: [tenant_id, variant_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_inventory_lot_variant_id")
  back_GoodsReceiptItem_lot_id GoodsReceiptItem[] @relation("GoodsReceiptItem_lot_id")
  back_InventoryBalance_lot_id InventoryBalance[] @relation("InventoryBalance_lot_id")
  back_StockMovement_lot_id StockMovement[] @relation("StockMovement_lot_id")
  back_StockReservation_lot_id StockReservation[] @relation("StockReservation_lot_id")
  back_SerializedItem_lot_id SerializedItem[] @relation("SerializedItem_lot_id")
  back_StockTransferItem_lot_id StockTransferItem[] @relation("StockTransferItem_lot_id")
  back_StockCountItem_lot_id StockCountItem[] @relation("StockCountItem_lot_id")
  @@unique([tenant_id, id])
  @@unique([tenant_id, variant_id, lot_number])
  @@map("inventory_lot")
  @@schema("commerce")
}

