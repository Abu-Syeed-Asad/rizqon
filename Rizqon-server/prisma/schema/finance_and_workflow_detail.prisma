// Finance and workflow detail models.

model ApprovalStep {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_id String @db.Uuid
  sequence Int
  required_role_id String @db.Uuid
  status String
  tenant_id String @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_request_id ApprovalRequest @relation("ApprovalStep_request_id", fields: [tenant_id, request_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_step_request_id")
  ref_required_role_id Role @relation("ApprovalStep_required_role_id", fields: [tenant_id, required_role_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_step_required_role_id")
  ref_tenant_id Tenant @relation("ApprovalStep_tenant_id", fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_step_tenant_id")
  back_ApprovalDecision_step_id ApprovalDecision[] @relation("ApprovalDecision_step_id")
  @@unique([tenant_id, id])
  @@unique([tenant_id, request_id, sequence])
  @@map("approval_step")
  @@schema("commerce")
}

model ApprovalDecision {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  step_id String @db.Uuid
  decided_by String @db.Uuid
  decision APPROVAL_DECISION_TYPE
  reason String?
  decided_at DateTime @db.Timestamptz(6)
  tenant_id String @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_step_id ApprovalStep @relation("ApprovalDecision_step_id", fields: [tenant_id, step_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_decision_step_id")
  ref_decided_by TenantMembership @relation("ApprovalDecision_decided_by", fields: [tenant_id, decided_by], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_decision_decided_by")
  ref_tenant_id Tenant @relation("ApprovalDecision_tenant_id", fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_decision_tenant_id")
  @@unique([tenant_id, id])
  @@unique([tenant_id, step_id, decided_by])
  @@map("approval_decision")
  @@schema("commerce")
}

model PaymentSettlementItem {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  settlement_id String @db.Uuid
  payment_id String? @db.Uuid
  refund_id String? @db.Uuid
  type String
  gross_amount Decimal @db.Decimal(20,4) @default(0)
  fee_amount Decimal @db.Decimal(20,4) @default(0)
  net_amount Decimal @db.Decimal(20,4)
  tenant_id String @db.Uuid
  currency String @db.VarChar(3)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_settlement_id PaymentSettlement @relation("PaymentSettlementItem_settlement_id", fields: [tenant_id, settlement_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_payment_settlement_item_settlement_id")
  ref_payment_id Payment? @relation("PaymentSettlementItem_payment_id", fields: [tenant_id, payment_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_payment_settlement_item_payment_id")
  ref_refund_id Refund? @relation("PaymentSettlementItem_refund_id", fields: [tenant_id, refund_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_payment_settlement_item_refund_id")
  ref_tenant_id Tenant @relation("PaymentSettlementItem_tenant_id", fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_payment_settlement_item_tenant_id")
  @@unique([tenant_id, id])
  @@map("payment_settlement_item")
  @@schema("commerce")
}

model RefundAttempt {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
