model DailySalesSnapshot {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  branch_id String @db.Uuid
  variant_id String @db.Uuid
  business_date DateTime @db.Date
  units_sold Decimal @db.Decimal(20,6)
  units_returned Decimal @db.Decimal(20,6)
  net_revenue Decimal @db.Decimal(20,4)
  cost_of_goods_sold Decimal @db.Decimal(20,4)
  closing_stock Decimal @db.Decimal(20,6)
  was_on_promotion Boolean @default(false)
  data_cutoff DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_tenant_id Tenant @relation("DailySalesSnapshot_tenant_id", fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_daily_sales_snapshot_tenant_id")
  ref_branch_id Branch @relation("DailySalesSnapshot_branch_id", fields: [tenant_id, branch_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_daily_sales_snapshot_branch_id")
  ref_variant_id ProductVariant @relation("DailySalesSnapshot_variant_id", fields: [tenant_id, variant_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_daily_sales_snapshot_variant_id")
  @@unique([tenant_id, id])
  @@unique([tenant_id, branch_id, variant_id, business_date])
  @@map("daily_sales_snapshot")
  @@schema("commerce")
}

