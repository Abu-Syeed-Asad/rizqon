// Catalog and pricing models.

model Product {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  brand_id String? @db.Uuid
  name String
  type String
  status String
  description String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_tenant_id Tenant @relation("Product_tenant_id", fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_product_tenant_id")
  ref_brand_id Brand? @relation("Product_brand_id", fields: [tenant_id, brand_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_product_brand_id")
  back_ProductVariant_product_id ProductVariant[] @relation("ProductVariant_product_id")
  back_ProductCategory_product_id ProductCategory[] @relation("ProductCategory_product_id")
  back_ProductMedia_product_id ProductMedia[] @relation("ProductMedia_product_id")
  @@unique([tenant_id, id])
  @@map("product")
  @@schema("commerce")
}

model ProductVariant {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  product_id String @db.Uuid
  unit_id String @db.Uuid
  sku String
  barcode String?
  tracking_mode String
  status String
  allow_backorder Boolean @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_tenant_id Tenant @relation("ProductVariant_tenant_id", fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_product_variant_tenant_id")
  ref_product_id Product @relation("ProductVariant_product_id", fields: [tenant_id, product_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_product_variant_product_id")
  ref_unit_id UnitOfMeasure @relation("ProductVariant_unit_id", fields: [tenant_id, unit_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_product_variant_unit_id")
  back_VariantAttributeValue_variant_id VariantAttributeValue[] @relation("VariantAttributeValue_variant_id")
  back_ProductMedia_variant_id ProductMedia[] @relation("ProductMedia_variant_id")
  back_PriceListItem_variant_id PriceListItem[] @relation("PriceListItem_variant_id")
  back_SupplierProduct_variant_id SupplierProduct[] @relation("SupplierProduct_variant_id")
  back_PurchaseOrderItem_variant_id PurchaseOrderItem[] @relation("PurchaseOrderItem_variant_id")
  back_GoodsReceiptItem_variant_id GoodsReceiptItem[] @relation("GoodsReceiptItem_variant_id")
  back_SupplierInvoiceItem_variant_id SupplierInvoiceItem[] @relation("SupplierInvoiceItem_variant_id")
  back_InventoryBalance_variant_id InventoryBalance[] @relation("InventoryBalance_variant_id")
  back_StockMovement_variant_id StockMovement[] @relation("StockMovement_variant_id")
  back_StockReservation_variant_id StockReservation[] @relation("StockReservation_variant_id")
  back_InventoryLot_variant_id InventoryLot[] @relation("InventoryLot_variant_id")
  back_SerializedItem_variant_id SerializedItem[] @relation("SerializedItem_variant_id")
  back_StockTransferItem_variant_id StockTransferItem[] @relation("StockTransferItem_variant_id")
  back_StockCountItem_variant_id StockCountItem[] @relation("StockCountItem_variant_id")
  back_ReorderPolicy_variant_id ReorderPolicy[] @relation("ReorderPolicy_variant_id")
  back_CartItem_variant_id CartItem[] @relation("CartItem_variant_id")
  back_OrderItem_variant_id OrderItem[] @relation("OrderItem_variant_id")
  back_DemandForecast_variant_id DemandForecast[] @relation("DemandForecast_variant_id")
  back_MarketplaceListing_variant_id MarketplaceListing[] @relation("MarketplaceListing_variant_id")
  back_DailySalesSnapshot_variant_id DailySalesSnapshot[] @relation("DailySalesSnapshot_variant_id")
  back_InventoryCostLayer_variant_id InventoryCostLayer[] @relation("InventoryCostLayer_variant_id")
  @@unique([tenant_id, id])
  @@unique([tenant_id, sku])
  @@map("product_variant")
  @@schema("commerce")
}

model Category {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  parent_id String? @db.Uuid
  name String
  slug String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_tenant_id Tenant @relation("Category_tenant_id", fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_category_tenant_id")
  ref_parent_id Category? @relation("Category_parent_id", fields: [tenant_id, parent_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_category_parent_id")
  back_Category_parent_id Category[] @relation("Category_parent_id")
  back_ProductCategory_category_id ProductCategory[] @relation("ProductCategory_category_id")
  back_CommissionRule_category_id CommissionRule[] @relation("CommissionRule_category_id")
  @@unique([tenant_id, id])
  @@unique([tenant_id, slug])
  @@map("category")
  @@schema("commerce")
}

model ProductCategory {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  product_id String @db.Uuid
  category_id String @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_tenant_id Tenant @relation("ProductCategory_tenant_id", fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_product_category_tenant_id")
  ref_product_id Product @relation("ProductCategory_product_id", fields: [tenant_id, product_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_product_category_product_id")
  ref_category_id Category @relation("ProductCategory_category_id", fields: [tenant_id, category_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_product_category_category_id")
  @@unique([tenant_id, id])
  @@unique([tenant_id, product_id, category_id])
  @@map("product_category")
  @@schema("commerce")
}

model Brand {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  name String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_tenant_id Tenant @relation("Brand_tenant_id", fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_brand_tenant_id")
  back_Product_brand_id Product[] @relation("Product_brand_id")
  @@unique([tenant_id, id])
  @@unique([tenant_id, name])
  @@map("brand")
  @@schema("commerce")
}

model UnitOfMeasure {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  code String
  quantity_precision Int
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_tenant_id Tenant @relation("UnitOfMeasure_tenant_id", fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_unit_of_measure_tenant_id")
  back_ProductVariant_unit_id ProductVariant[] @relation("ProductVariant_unit_id")
  @@unique([tenant_id, id])
  @@unique([tenant_id, code])
  @@map("unit_of_measure")
  @@schema("commerce")
}

model ProductAttribute {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  name String
  data_type String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_tenant_id Tenant @relation("ProductAttribute_tenant_id", fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_product_attribute_tenant_id")
  back_VariantAttributeValue_attribute_id VariantAttributeValue[] @relation("VariantAttributeValue_attribute_id")
  @@unique([tenant_id, id])
  @@unique([tenant_id, name])
  @@map("product_attribute")
  @@schema("commerce")
}

model VariantAttributeValue {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  variant_id String @db.Uuid
  attribute_id String @db.Uuid
  value String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_tenant_id Tenant @relation("VariantAttributeValue_tenant_id", fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_variant_attribute_value_tenant_id")
  ref_variant_id ProductVariant @relation("VariantAttributeValue_variant_id", fields: [tenant_id, variant_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_variant_attribute_value_variant_id")
  ref_attribute_id ProductAttribute @relation("VariantAttributeValue_attribute_id", fields: [tenant_id, attribute_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_variant_attribute_value_attribute_id")
  @@unique([tenant_id, id])
  @@unique([tenant_id, variant_id, attribute_id])
  @@map("variant_attribute_value")
  @@schema("commerce")
}

model ProductMedia {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  product_id String @db.Uuid
  variant_id String? @db.Uuid
  file_id String @db.Uuid
  display_order Int
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_tenant_id Tenant @relation("ProductMedia_tenant_id", fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_product_media_tenant_id")
  ref_product_id Product @relation("ProductMedia_product_id", fields: [tenant_id, product_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_product_media_product_id")
  ref_variant_id ProductVariant? @relation("ProductMedia_variant_id", fields: [tenant_id, variant_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_product_media_variant_id")
  ref_file_id FileObject @relation("ProductMedia_file_id", fields: [file_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_product_media_file_id")
  @@unique([tenant_id, id])
  @@map("product_media")
  @@schema("commerce")
}

model PriceList {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  branch_id String? @db.Uuid
  segment_id String? @db.Uuid
  name String
  currency String @db.VarChar(3)
  valid_from DateTime @db.Timestamptz(6)
  valid_until DateTime? @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_tenant_id Tenant @relation("PriceList_tenant_id", fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_price_list_tenant_id")
  ref_branch_id Branch? @relation("PriceList_branch_id", fields: [tenant_id, branch_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_price_list_branch_id")
  ref_segment_id CustomerSegment? @relation("PriceList_segment_id", fields: [tenant_id, segment_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_price_list_segment_id")
  back_PriceListItem_price_list_id PriceListItem[] @relation("PriceListItem_price_list_id")
  @@unique([tenant_id, id])
  @@map("price_list")
  @@schema("commerce")
}

model PriceListItem {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  price_list_id String @db.Uuid
  variant_id String @db.Uuid
  min_quantity Decimal @db.Decimal(20,6)
  unit_price Decimal @db.Decimal(20,4)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_tenant_id Tenant @relation("PriceListItem_tenant_id", fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_price_list_item_tenant_id")
  ref_price_list_id PriceList @relation("PriceListItem_price_list_id", fields: [tenant_id, price_list_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_price_list_item_price_list_id")
  ref_variant_id ProductVariant @relation("PriceListItem_variant_id", fields: [tenant_id, variant_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_price_list_item_variant_id")
  @@unique([tenant_id, id])
  @@unique([tenant_id, price_list_id, variant_id, min_quantity])
  @@map("price_list_item")
  @@schema("commerce")
}
