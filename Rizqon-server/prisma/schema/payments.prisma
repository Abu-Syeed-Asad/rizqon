model PaymentWebhookEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider_account_id String @db.Uuid
  provider_event_id String
  payload_hash String
  verification_status String
  processing_status String
  tenant_id String @db.Uuid
  received_at DateTime @db.Timestamptz(6)
  processed_at DateTime? @db.Timestamptz(6)
  payload_reference String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_provider_account_id PaymentProviderAccount @relation("PaymentWebhookEvent_provider_account_id", fields: [tenant_id, provider_account_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_payment_webhook_event_provider_account_id")
  ref_tenant_id Tenant @relation("PaymentWebhookEvent_tenant_id", fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_payment_webhook_event_tenant_id")
  @@unique([tenant_id, id])
  @@unique([provider_account_id, provider_event_id])
  @@map("payment_webhook_event")
  @@schema("commerce")
}

model Refund {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  payment_id String @db.Uuid
  return_id String? @db.Uuid
  amount Decimal @db.Decimal(20,4)
  currency String @db.VarChar(3)
  status REFUND_STATUS @default(REQUESTED)
  idempotency_key String
  reason String
  approved_by String? @db.Uuid
  completed_at DateTime? @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_tenant_id Tenant @relation("Refund_tenant_id", fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_refund_tenant_id")
  ref_payment_id Payment @relation("Refund_payment_id", fields: [tenant_id, payment_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_refund_payment_id")
  ref_return_id ReturnRequest? @relation("Refund_return_id", fields: [tenant_id, return_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_refund_return_id")
  ref_approved_by TenantMembership? @relation("Refund_approved_by", fields: [tenant_id, approved_by], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_refund_approved_by")
  back_CashMovement_refund_id CashMovement[] @relation("CashMovement_refund_id")
  back_PaymentSettlementItem_refund_id PaymentSettlementItem[] @relation("PaymentSettlementItem_refund_id")
  back_RefundAttempt_refund_id RefundAttempt[] @relation("RefundAttempt_refund_id")
  back_RefundAllocation_refund_id RefundAllocation[] @relation("RefundAllocation_refund_id")
  @@unique([tenant_id, id])
  @@unique([tenant_id, idempotency_key])
  @@map("refund")
  @@schema("commerce")
}

