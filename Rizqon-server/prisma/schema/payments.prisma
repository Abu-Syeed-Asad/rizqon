  @@unique([tenant_id, id])
  @@unique([tenant_id, payment_id, provider_case_id])
  @@map("payment_dispute")
  @@schema("commerce")
}

model PaymentSettlement {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  provider_account_id String @db.Uuid
  external_id String
  currency String @db.VarChar(3)
  gross_amount Decimal @db.Decimal(20,4) @default(0)
  fee_amount Decimal @db.Decimal(20,4) @default(0)
  net_amount Decimal @db.Decimal(20,4)
  status String
  settled_at DateTime? @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_tenant_id Tenant @relation("PaymentSettlement_tenant_id", fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_payment_settlement_tenant_id")
  ref_provider_account_id PaymentProviderAccount @relation("PaymentSettlement_provider_account_id", fields: [tenant_id, provider_account_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_payment_settlement_provider_account_id")
  back_PaymentSettlementItem_settlement_id PaymentSettlementItem[] @relation("PaymentSettlementItem_settlement_id")
