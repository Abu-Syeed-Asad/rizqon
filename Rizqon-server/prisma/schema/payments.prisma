// Payments models.

model PaymentMethod {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  type PAYMENT_METHOD_TYPE
  display_name String
  enabled Boolean @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_tenant_id Tenant @relation("PaymentMethod_tenant_id", fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_payment_method_tenant_id")
  back_Payment_method_id Payment[] @relation("Payment_method_id")
  @@unique([tenant_id, id])
  @@map("payment_method")
  @@schema("commerce")
}

model PaymentProviderAccount {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  provider String
  merchant_reference String
  secret_reference String
  status String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_tenant_id Tenant @relation("PaymentProviderAccount_tenant_id", fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_payment_provider_account_tenant_id")
  back_Payment_provider_account_id Payment[] @relation("Payment_provider_account_id")
  back_PaymentAttempt_provider_account_id PaymentAttempt[] @relation("PaymentAttempt_provider_account_id")
  back_PaymentWebhookEvent_provider_account_id PaymentWebhookEvent[] @relation("PaymentWebhookEvent_provider_account_id")
  back_PaymentSettlement_provider_account_id PaymentSettlement[] @relation("PaymentSettlement_provider_account_id")
  back_SellerPayoutAccount_provider_account_id SellerPayoutAccount[] @relation("SellerPayoutAccount_provider_account_id")
  @@unique([tenant_id, id])
  @@map("payment_provider_account")
  @@schema("commerce")
}

model Payment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  customer_id String? @db.Uuid
  method_id String @db.Uuid
  provider_account_id String? @db.Uuid
  amount Decimal @db.Decimal(20,4)
  currency String @db.VarChar(3)
  status PAYMENT_STATUS @default(PENDING)
  idempotency_key String
  direction String @default("INBOUND")
  COLLECTION_CHANNEL COLLECTION_CHANNEL @default(ONLINE)
  COLLECTION_TIMING COLLECTION_TIMING @default(PREPAID)
  received_at DateTime? @db.Timestamptz(6)
  confirmed_amount Decimal @db.Decimal(20,4) @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_tenant_id Tenant @relation("Payment_tenant_id", fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_payment_tenant_id")
  ref_customer_id Customer? @relation("Payment_customer_id", fields: [tenant_id, customer_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_payment_customer_id")
  ref_method_id PaymentMethod @relation("Payment_method_id", fields: [tenant_id, method_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_payment_method_id")
  ref_provider_account_id PaymentProviderAccount? @relation("Payment_provider_account_id", fields: [tenant_id, provider_account_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_payment_provider_account_id")
  back_PaymentAttempt_payment_id PaymentAttempt[] @relation("PaymentAttempt_payment_id")
  back_PaymentEvent_payment_id PaymentEvent[] @relation("PaymentEvent_payment_id")
  back_PaymentAllocation_payment_id PaymentAllocation[] @relation("PaymentAllocation_payment_id")
  back_Refund_payment_id Refund[] @relation("Refund_payment_id")
  back_PaymentDispute_payment_id PaymentDispute[] @relation("PaymentDispute_payment_id")
  back_CashMovement_payment_id CashMovement[] @relation("CashMovement_payment_id")
  back_CodCollection_payment_id CodCollection[] @relation("CodCollection_payment_id")
  back_PaymentSettlementItem_payment_id PaymentSettlementItem[] @relation("PaymentSettlementItem_payment_id")
  @@unique([tenant_id, id])
  @@unique([tenant_id, idempotency_key])
  @@map("payment")
  @@schema("commerce")
}

model PaymentAttempt {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  payment_id String @db.Uuid
  provider_transaction_reference String?
  status String
  failure_code String?
  provider_account_id String @db.Uuid
  provider_request_reference String
  initiated_at DateTime @db.Timestamptz(6)
  completed_at DateTime? @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_tenant_id Tenant @relation("PaymentAttempt_tenant_id", fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_payment_attempt_tenant_id")
  ref_payment_id Payment @relation("PaymentAttempt_payment_id", fields: [tenant_id, payment_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_payment_attempt_payment_id")
  ref_provider_account_id PaymentProviderAccount @relation("PaymentAttempt_provider_account_id", fields: [tenant_id, provider_account_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_payment_attempt_provider_account_id")
  back_PaymentEvent_attempt_id PaymentEvent[] @relation("PaymentEvent_attempt_id")
  @@unique([tenant_id, id])
  @@map("payment_attempt")
  @@schema("commerce")
}

model PaymentEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  payment_id String @db.Uuid
  attempt_id String? @db.Uuid
  event_type String
  amount Decimal? @db.Decimal(20,4)
  occurred_at DateTime @db.Timestamptz(6)
  provider_event_reference String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_tenant_id Tenant @relation("PaymentEvent_tenant_id", fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_payment_event_tenant_id")
  ref_payment_id Payment @relation("PaymentEvent_payment_id", fields: [tenant_id, payment_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_payment_event_payment_id")
  ref_attempt_id PaymentAttempt? @relation("PaymentEvent_attempt_id", fields: [tenant_id, attempt_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_payment_event_attempt_id")
  @@unique([tenant_id, id])
  @@map("payment_event")
  @@schema("commerce")
}

model PaymentAllocation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  payment_id String @db.Uuid
  invoice_id String @db.Uuid
  allocated_amount Decimal @db.Decimal(20,4)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_tenant_id Tenant @relation("PaymentAllocation_tenant_id", fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_payment_allocation_tenant_id")
  ref_payment_id Payment @relation("PaymentAllocation_payment_id", fields: [tenant_id, payment_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_payment_allocation_payment_id")
  ref_invoice_id SalesInvoice @relation("PaymentAllocation_invoice_id", fields: [tenant_id, invoice_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_payment_allocation_invoice_id")
  back_RefundAllocation_payment_allocation_id RefundAllocation[] @relation("RefundAllocation_payment_allocation_id")
  @@unique([tenant_id, id])
