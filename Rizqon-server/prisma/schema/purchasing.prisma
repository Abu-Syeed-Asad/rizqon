  tenant_id String @db.Uuid
  invoice_id String @db.Uuid
  po_item_id String? @db.Uuid
  variant_id String? @db.Uuid
  quantity Decimal @db.Decimal(20,6)
  unit_cost Decimal @db.Decimal(20,4)
  description String
  line_total Decimal @db.Decimal(20,4)
  tax_amount Decimal @db.Decimal(20,4) @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_tenant_id Tenant @relation("SupplierInvoiceItem_tenant_id", fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_supplier_invoice_item_tenant_id")
  ref_invoice_id SupplierInvoice @relation("SupplierInvoiceItem_invoice_id", fields: [tenant_id, invoice_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_supplier_invoice_item_invoice_id")
