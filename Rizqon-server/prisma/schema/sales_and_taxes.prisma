  ref_variant_id ProductVariant? @relation("OrderItem_variant_id", fields: [tenant_id, variant_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_order_item_variant_id")
  back_StockReservation_order_item_id StockReservation[] @relation("StockReservation_order_item_id")
  back_SerializedItem_sold_order_item_id SerializedItem[] @relation("SerializedItem_sold_order_item_id")
  back_OrderItemTax_order_item_id OrderItemTax[] @relation("OrderItemTax_order_item_id")
  back_ShipmentItem_order_item_id ShipmentItem[] @relation("ShipmentItem_order_item_id")
  back_ReturnItem_order_item_id ReturnItem[] @relation("ReturnItem_order_item_id")
  back_ReplacementLink_replacement_item_id ReplacementLink[] @relation("ReplacementLink_replacement_item_id")
  back_SellerEarning_order_item_id SellerEarning[] @relation("SellerEarning_order_item_id")
  @@unique([tenant_id, id])
  @@map("order_item")
  @@schema("commerce")
}

