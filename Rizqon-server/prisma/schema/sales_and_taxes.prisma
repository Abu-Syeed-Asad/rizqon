// Sales and taxes models.

model Cart {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  customer_id String? @db.Uuid
  branch_id String? @db.Uuid
  guest_token_hash String?
  currency String @db.VarChar(3)
  expires_at DateTime @db.Timestamptz(6)
  status String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_tenant_id Tenant @relation("Cart_tenant_id", fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_cart_tenant_id")
  ref_customer_id Customer? @relation("Cart_customer_id", fields: [tenant_id, customer_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_cart_customer_id")
  ref_branch_id Branch? @relation("Cart_branch_id", fields: [tenant_id, branch_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_cart_branch_id")
  back_CartItem_cart_id CartItem[] @relation("CartItem_cart_id")
  @@unique([tenant_id, id])
  @@map("cart")
  @@schema("commerce")
}

model CartItem {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  cart_id String @db.Uuid
  variant_id String @db.Uuid
  quantity Decimal @db.Decimal(20,6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_tenant_id Tenant @relation("CartItem_tenant_id", fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_cart_item_tenant_id")
  ref_cart_id Cart @relation("CartItem_cart_id", fields: [tenant_id, cart_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_cart_item_cart_id")
  ref_variant_id ProductVariant @relation("CartItem_variant_id", fields: [tenant_id, variant_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_cart_item_variant_id")
  @@unique([tenant_id, id])
  @@unique([tenant_id, cart_id, variant_id])
  @@map("cart_item")
  @@schema("commerce")
}

model Order {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  branch_id String @db.Uuid
  customer_id String? @db.Uuid
  checkout_group_id String? @db.Uuid
  number String
  channel ORDER_CHANNEL
  currency String @db.VarChar(3)
  status ORDER_STATUS @default(DRAFT)
  grand_total Decimal @db.Decimal(20,4)
  seller_id String? @db.Uuid
  PAYMENT_STATUS String
  fulfillment_status String
  subtotal Decimal @db.Decimal(20,4)
  discount_total Decimal @db.Decimal(20,4) @default(0)
  tax_total Decimal @db.Decimal(20,4) @default(0)
  shipping_total Decimal @db.Decimal(20,4) @default(0)
  placed_at DateTime? @db.Timestamptz(6)
  cancelled_at DateTime? @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_tenant_id Tenant @relation("Order_tenant_id", fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_order_tenant_id")
  ref_branch_id Branch @relation("Order_branch_id", fields: [tenant_id, branch_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_order_branch_id")
  ref_customer_id Customer? @relation("Order_customer_id", fields: [tenant_id, customer_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_order_customer_id")
  ref_checkout_group_id CheckoutGroup? @relation("Order_checkout_group_id", fields: [checkout_group_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_order_checkout_group_id")
  ref_seller_id TenantMembership? @relation("Order_seller_id", fields: [tenant_id, seller_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_order_seller_id")
  back_OrderItem_order_id OrderItem[] @relation("OrderItem_order_id")
  back_OrderAddress_order_id OrderAddress[] @relation("OrderAddress_order_id")
  back_OrderStatusEvent_order_id OrderStatusEvent[] @relation("OrderStatusEvent_order_id")
  back_PromotionRedemption_order_id PromotionRedemption[] @relation("PromotionRedemption_order_id")
  back_SalesInvoice_order_id SalesInvoice[] @relation("SalesInvoice_order_id")
  back_Shipment_order_id Shipment[] @relation("Shipment_order_id")
  back_ReturnRequest_order_id ReturnRequest[] @relation("ReturnRequest_order_id")
  back_SupportTicket_order_id SupportTicket[] @relation("SupportTicket_order_id")
  @@unique([tenant_id, id])
  @@unique([tenant_id, number])
  @@map("order")
  @@schema("commerce")
}

model OrderItem {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  order_id String @db.Uuid
  variant_id String? @db.Uuid
  sku_snapshot String
  name_snapshot String
  quantity Decimal @db.Decimal(20,6)
  unit_price Decimal @db.Decimal(20,4)
  tax_total Decimal @db.Decimal(20,4) @default(0)
  line_total Decimal @db.Decimal(20,4)
  discount_total Decimal @db.Decimal(20,4) @default(0)
  cost_total Decimal? @db.Decimal(20,4)
  fulfilled_quantity Decimal @db.Decimal(20,6) @default(0)
  returned_quantity Decimal @db.Decimal(20,6) @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
