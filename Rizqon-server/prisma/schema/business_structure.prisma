model TenantSetting {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  key String
  value_json Json @db.JsonB
  config_version Int @default(1)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_tenant_id Tenant @relation("TenantSetting_tenant_id", fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_tenant_setting_tenant_id")
  @@unique([tenant_id, id])
  @@unique([tenant_id, key])
  @@map("tenant_setting")
  @@schema("commerce")
}

model Branch {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  address_id String @db.Uuid
  code String
  name String
  timezone String
  phone String?
  status String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_tenant_id Tenant @relation("Branch_tenant_id", fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_branch_tenant_id")
  ref_address_id Address @relation("Branch_address_id", fields: [tenant_id, address_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_branch_address_id")
  back_Department_branch_id Department[] @relation("Department_branch_id")
  back_Location_branch_id Location[] @relation("Location_branch_id")
  back_DocumentSequence_branch_id DocumentSequence[] @relation("DocumentSequence_branch_id")
  back_AccessScope_branch_id AccessScope[] @relation("AccessScope_branch_id")
  back_EmployeeBranchAssignment_branch_id EmployeeBranchAssignment[] @relation("EmployeeBranchAssignment_branch_id")
  back_WorkShift_branch_id WorkShift[] @relation("WorkShift_branch_id")
  back_Task_branch_id Task[] @relation("Task_branch_id")
  back_PriceList_branch_id PriceList[] @relation("PriceList_branch_id")
  back_Cart_branch_id Cart[] @relation("Cart_branch_id")
  back_Order_branch_id Order[] @relation("Order_branch_id")
  back_PosTerminal_branch_id PosTerminal[] @relation("PosTerminal_branch_id")
  back_CashDrawer_branch_id CashDrawer[] @relation("CashDrawer_branch_id")
  back_CashDeposit_branch_id CashDeposit[] @relation("CashDeposit_branch_id")
  back_JournalLine_branch_id JournalLine[] @relation("JournalLine_branch_id")
  back_Expense_branch_id Expense[] @relation("Expense_branch_id")
  back_BusinessInsight_branch_id BusinessInsight[] @relation("BusinessInsight_branch_id")
  back_DailySalesSnapshot_branch_id DailySalesSnapshot[] @relation("DailySalesSnapshot_branch_id")
  @@unique([tenant_id, id])
  @@unique([tenant_id, code])
  @@map("branch")
  @@schema("commerce")
}

model Department {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  branch_id String? @db.Uuid
  parent_id String? @db.Uuid
  name String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_tenant_id Tenant @relation("Department_tenant_id", fields: [tenant_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_department_tenant_id")
  ref_branch_id Branch? @relation("Department_branch_id", fields: [tenant_id, branch_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_department_branch_id")
  ref_parent_id Department? @relation("Department_parent_id", fields: [tenant_id, parent_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Restrict, map: "fk_department_parent_id")
  back_Department_parent_id Department[] @relation("Department_parent_id")
  back_AccessScope_department_id AccessScope[] @relation("AccessScope_department_id")
  back_EmployeeProfile_department_id EmployeeProfile[] @relation("EmployeeProfile_department_id")
  @@unique([tenant_id, id])
  @@map("department")
  @@schema("commerce")
}

