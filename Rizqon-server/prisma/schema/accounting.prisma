  ref_payment_id SupplierPayment @relation("SupplierPaymentAllocation_payment_id", fields: [tenant_id, payment_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_supplier_payment_allocation_payment_id")
  ref_invoice_id SupplierInvoice @relation("SupplierPaymentAllocation_invoice_id", fields: [tenant_id, invoice_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_supplier_payment_allocation_invoice_id")
