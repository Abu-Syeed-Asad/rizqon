// Marketplace extension models.

model MarketplaceListing {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id String @db.Uuid
  variant_id String @db.Uuid
  public_title String
  status String
  published_at DateTime? @db.Timestamptz(6)
  tenant_id String @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_company_id SellerCompany @relation("MarketplaceListing_company_id", fields: [tenant_id, company_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_marketplace_listing_company_id")
  ref_variant_id ProductVariant @relation("MarketplaceListing_variant_id", fields: [tenant_id, variant_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_marketplace_listing_variant_id")
  ref_tenant_id Tenant @relation("MarketplaceListing_tenant_id", fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_marketplace_listing_tenant_id")
  @@unique([tenant_id, id])
  @@unique([tenant_id, company_id, variant_id])
  @@map("marketplace_listing")
  @@schema("commerce")
}

model CheckoutGroup {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  buyer_user_id String? @db.Uuid
  currency String @db.VarChar(3)
  status String
  checkout_reference String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_buyer_user_id User? @relation("CheckoutGroup_buyer_user_id", fields: [buyer_user_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_checkout_group_buyer_user_id")
  back_Order_checkout_group_id Order[] @relation("Order_checkout_group_id")
  @@unique([checkout_reference])
  @@map("checkout_group")
  @@schema("commerce")
}

model CommissionRule {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id String? @db.Uuid
  category_id String? @db.Uuid
  rate Decimal @db.Decimal(9,6)
  fixed_fee Decimal @db.Decimal(20,4)
  currency String @db.VarChar(3)
  valid_from DateTime @db.Timestamptz(6)
  valid_until DateTime? @db.Timestamptz(6)
  tenant_id String @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_company_id SellerCompany? @relation("CommissionRule_company_id", fields: [tenant_id, company_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_commission_rule_company_id")
  ref_category_id Category? @relation("CommissionRule_category_id", fields: [tenant_id, category_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_commission_rule_category_id")
  ref_tenant_id Tenant @relation("CommissionRule_tenant_id", fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_commission_rule_tenant_id")
  back_SellerEarning_rule_id SellerEarning[] @relation("SellerEarning_rule_id")
  @@unique([tenant_id, id])
  @@map("commission_rule")
  @@schema("commerce")
}

model SellerEarning {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id String @db.Uuid
  order_item_id String @db.Uuid
  rule_id String @db.Uuid
  gross_amount Decimal @db.Decimal(20,4) @default(0)
  commission_amount Decimal @db.Decimal(20,4)
  net_amount Decimal @db.Decimal(20,4)
  currency String @db.VarChar(3)
  status String
  tenant_id String @db.Uuid
  recognized_at DateTime? @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_company_id SellerCompany @relation("SellerEarning_company_id", fields: [tenant_id, company_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_seller_earning_company_id")
  ref_order_item_id OrderItem @relation("SellerEarning_order_item_id", fields: [tenant_id, order_item_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_seller_earning_order_item_id")
  ref_rule_id CommissionRule @relation("SellerEarning_rule_id", fields: [tenant_id, rule_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_seller_earning_rule_id")
  ref_tenant_id Tenant @relation("SellerEarning_tenant_id", fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_seller_earning_tenant_id")
  back_SellerPayoutItem_earning_id SellerPayoutItem[] @relation("SellerPayoutItem_earning_id")
  @@unique([tenant_id, id])
  @@map("seller_earning")
  @@schema("commerce")
}

model SellerPayout {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id String @db.Uuid
  payout_account_id String @db.Uuid
  amount Decimal @db.Decimal(20,4)
  currency String @db.VarChar(3)
  status String
  idempotency_key String
  tenant_id String @db.Uuid
  requested_at DateTime @db.Timestamptz(6)
  completed_at DateTime? @db.Timestamptz(6)
  provider_reference String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_company_id SellerCompany @relation("SellerPayout_company_id", fields: [tenant_id, company_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_seller_payout_company_id")
  ref_payout_account_id SellerPayoutAccount @relation("SellerPayout_payout_account_id", fields: [tenant_id, payout_account_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_seller_payout_payout_account_id")
  ref_tenant_id Tenant @relation("SellerPayout_tenant_id", fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_seller_payout_tenant_id")
  back_SellerPayoutItem_payout_id SellerPayoutItem[] @relation("SellerPayoutItem_payout_id")
  @@unique([tenant_id, id])
  @@unique([tenant_id, idempotency_key])
  @@map("seller_payout")
  @@schema("commerce")
}

model SellerPayoutItem {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payout_id String @db.Uuid
  earning_id String @db.Uuid
  allocated_amount Decimal @db.Decimal(20,4)
  tenant_id String @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  row_version Int @default(1)
  ref_payout_id SellerPayout @relation("SellerPayoutItem_payout_id", fields: [tenant_id, payout_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_seller_payout_item_payout_id")
  ref_earning_id SellerEarning @relation("SellerPayoutItem_earning_id", fields: [tenant_id, earning_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade, map: "fk_seller_payout_item_earning_id")
  ref_tenant_id Tenant @relation("SellerPayoutItem_tenant_id", fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_seller_payout_item_tenant_id")
  @@unique([tenant_id, id])
  @@unique([tenant_id, payout_id, earning_id])
  @@map("seller_payout_item")
  @@schema("commerce")
}
