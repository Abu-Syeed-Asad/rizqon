model PurchaseItem {
  id         String         @id @default(cuid())
  businessId String
  quantity   Decimal        @db.Decimal(18, 3)
  unitCost   Decimal        @db.Decimal(18, 2)
  lineTotal  Decimal        @db.Decimal(18, 2)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt()
  business   Business       @relation("PurchaseItem_business", fields: [businessId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  purchaseId String
  purchase   Purchase       @relation("PurchaseItem_purchase", fields: [businessId, purchaseId], references: [businessId, id], onDelete: Restrict, onUpdate: NoAction)
  variantId  String
  variant    ProductVariant @relation("PurchaseItem_variant", fields: [businessId, variantId], references: [businessId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([businessId, id])
  @@unique([businessId, purchaseId, variantId])
  @@index([businessId])
  @@index([businessId, purchaseId])
  @@index([businessId, variantId])
  @@schema("commerce")
}