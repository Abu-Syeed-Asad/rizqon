// RIZQON PostgreSQL + Prisma schema
// 22 core tables. Review provider-specific details and run `prisma validate`
// before applying to a production database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum BusinessStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  CLOSED
}

enum MembershipRole {
  OWNER
  MANAGER
  INVENTORY_STAFF
  SALES_STAFF
  VIEWER
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

enum StockMovementType {
  OPENING
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
  TRANSFER_IN
  TRANSFER_OUT
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  INITIATED
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentProvider {
  MANUAL
  STRIPE
  SSLCOMMERZ
  BKASH
  NAGAD
  OTHER
}

enum ReturnStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RECEIVED
  COMPLETED
  CANCELLED
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ShipmentStatus {
  PENDING
  READY
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum ForecastRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model User {
  id             String                @id @default(uuid()) @db.Uuid
  email          String                @unique @db.VarChar(320)
  passwordHash   String?               @map("password_hash") @db.VarChar(255)
  fullName       String                @map("full_name") @db.VarChar(160)
  status         AccountStatus         @default(ACTIVE)
  lastLoginAt    DateTime?             @map("last_login_at") @db.Timestamptz(6)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships    BusinessMembership[]
  auditLogs      AuditLog[]            @relation("AuditActor")
  stockMovements StockMovement[]       @relation("StockMovementActor")
  reviewedReturns ReturnRequest[]      @relation("ReturnReviewer")

  @@map("users")
}

model Business {
  id           String                @id @default(uuid()) @db.Uuid
  name         String                @db.VarChar(180)
  slug         String                @unique @db.VarChar(100)
  status       BusinessStatus        @default(TRIAL)
  email        String?               @db.VarChar(320)
  phone        String?               @db.VarChar(40)
  address      String?               @db.Text
  currency     String                @default("BDT") @db.Char(3)
  timezone     String                @default("Asia/Dhaka") @db.VarChar(80)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships  BusinessMembership[]
  categories   Category[]
  products     Product[]
  inventory    InventoryBalance[]
  stockMoves   StockMovement[]
  customers    Customer[]
  suppliers    Supplier[]
  orders       Order[]
  payments     Payment[]
  returns      ReturnRequest[]
  refunds      Refund[]
  shipments    Shipment[]
  notifications Notification[]
  auditLogs    AuditLog[]
  productMetrics ProductDailyMetric[]
  forecastRuns ForecastRun[]
  settings     BusinessSetting[]

  @@map("businesses")
}

model BusinessMembership {
  id         String         @id @default(uuid()) @db.Uuid
  businessId String         @map("business_id") @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  role       MembershipRole @default(VIEWER)
  status     AccountStatus  @default(INVITED)
  invitedAt  DateTime?      @map("invited_at") @db.Timestamptz(6)
  joinedAt   DateTime?      @map("joined_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId, status])
  @@index([businessId, role])
  @@map("business_memberships")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  name        String    @db.VarChar(120)
  description String?   @db.Text
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([businessId, name])
  @@index([businessId, status])
  @@map("categories")
}

model Product {
  id              String                @id @default(uuid()) @db.Uuid
  businessId      String                @map("business_id") @db.Uuid
  categoryId      String?               @map("category_id") @db.Uuid
  sku             String                @db.VarChar(100)
  name            String                @db.VarChar(200)
  description     String?               @db.Text
  unitPrice       Decimal               @map("unit_price") @db.Decimal(12, 2)
  currency        String                @default("BDT") @db.Char(3)
  reorderLevel    Decimal               @default(0) @map("reorder_level") @db.Decimal(12, 3)
  status          RecordStatus          @default(ACTIVE)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category        Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inventory       InventoryBalance?
  stockMovements  StockMovement[]
  orderItems      OrderItem[]
  dailyMetrics    ProductDailyMetric[]
  forecasts       DemandForecast[]

  @@unique([businessId, sku])
  @@index([businessId, name])
  @@index([businessId, categoryId, status])
  @@map("products")
}

model InventoryBalance {
  id              String   @id @default(uuid()) @db.Uuid
  businessId      String   @map("business_id") @db.Uuid
  productId       String   @unique @map("product_id") @db.Uuid
  quantityOnHand  Decimal  @default(0) @map("quantity_on_hand") @db.Decimal(12, 3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([businessId, quantityOnHand])
  @@map("inventory_balances")
}

model StockMovement {
  id            String            @id @default(uuid()) @db.Uuid
  businessId    String            @map("business_id") @db.Uuid
  productId     String            @map("product_id") @db.Uuid
  actorUserId   String?           @map("actor_user_id") @db.Uuid
  movementType  StockMovementType @map("movement_type")
  quantityDelta Decimal           @map("quantity_delta") @db.Decimal(12, 3)
  referenceType String?           @map("reference_type") @db.VarChar(60)
  referenceId   String?           @map("reference_id") @db.VarChar(100)
  note          String?           @db.Text
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product       Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  actor         User?             @relation("StockMovementActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([businessId, productId, createdAt])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  fullName   String   @map("full_name") @db.VarChar(160)
  email      String?  @db.VarChar(320)
  phone      String?  @db.VarChar(40)
  address    String?  @db.Text
  notes      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@index([businessId, fullName])
  @@index([businessId, email])
  @@index([businessId, phone])
  @@map("customers")
}

model Supplier {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  name       String   @db.VarChar(180)
  email      String?  @db.VarChar(320)
  phone      String?  @db.VarChar(40)
  address    String?  @db.Text
  notes      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, name])
  @@map("suppliers")
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  businessId     String      @map("business_id") @db.Uuid
  customerId     String?     @map("customer_id") @db.Uuid
  orderNumber    String      @map("order_number") @db.VarChar(80)
  status         OrderStatus @default(DRAFT)
  subtotal       Decimal     @default(0) @db.Decimal(12, 2)
  taxTotal       Decimal     @default(0) @map("tax_total") @db.Decimal(12, 2)
  discountTotal  Decimal     @default(0) @map("discount_total") @db.Decimal(12, 2)
  grandTotal     Decimal     @default(0) @map("grand_total") @db.Decimal(12, 2)
  currency       String      @default("BDT") @db.Char(3)
  notes          String?     @db.Text
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  business       Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer       Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  payments       Payment[]
  returns        ReturnRequest[]
  shipments      Shipment[]

  @@unique([businessId, orderNumber])
  @@index([businessId, status, createdAt])
  @@index([businessId, customerId])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  skuSnapshot  String   @map("sku_snapshot") @db.VarChar(100)
  nameSnapshot String   @map("name_snapshot") @db.VarChar(200)
  quantity     Decimal  @db.Decimal(12, 3)
  unitPrice    Decimal  @map("unit_price") @db.Decimal(12, 2)
  lineTotal    Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  returnItems  ReturnItem[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  businessId        String          @map("business_id") @db.Uuid
  orderId           String          @map("order_id") @db.Uuid
  provider          PaymentProvider @default(MANUAL)
  providerReference String?         @map("provider_reference") @db.VarChar(180)
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("BDT") @db.Char(3)
  status            PaymentStatus   @default(INITIATED)
  paidAt            DateTime?       @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  business          Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, providerReference])
  @@index([businessId, status, createdAt])
  @@index([orderId])
  @@map("payments")
}

model ReturnRequest {
  id              String       @id @default(uuid()) @db.Uuid
  businessId      String       @map("business_id") @db.Uuid
  orderId         String       @map("order_id") @db.Uuid
  requestedByName String?      @map("requested_by_name") @db.VarChar(160)
  reason          String       @db.Text
  status          ReturnStatus @default(REQUESTED)
  reviewedById    String?      @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?    @map("reviewed_at") @db.Timestamptz(6)
  receivedAt      DateTime?    @map("received_at") @db.Timestamptz(6)
  completedAt     DateTime?    @map("completed_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  business        Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewer        User?        @relation("ReturnReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  items           ReturnItem[]
  refunds         Refund[]

  @@index([businessId, status, createdAt])
  @@index([orderId])
  @@map("return_requests")
}

model ReturnItem {
  id             String       @id @default(uuid()) @db.Uuid
  returnRequestId String      @map("return_request_id") @db.Uuid
  orderItemId    String       @map("order_item_id") @db.Uuid
  quantity       Decimal      @db.Decimal(12, 3)
  conditionNote  String?      @map("condition_note") @db.Text
  restockable    Boolean      @default(false)
  returnRequest  ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem      OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
  @@map("return_items")
}

model Refund {
  id                String       @id @default(uuid()) @db.Uuid
  businessId        String       @map("business_id") @db.Uuid
  returnRequestId   String       @map("return_request_id") @db.Uuid
  providerReference String?      @map("provider_reference") @db.VarChar(180)
  amount            Decimal      @db.Decimal(12, 2)
  currency          String       @default("BDT") @db.Char(3)
  status            RefundStatus @default(REQUESTED)
  processedAt       DateTime?    @map("processed_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  business          Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  returnRequest     ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@index([businessId, status, createdAt])
  @@index([returnRequestId])
  @@map("refunds")
}

model Shipment {
  id              String         @id @default(uuid()) @db.Uuid
  businessId      String         @map("business_id") @db.Uuid
  orderId         String         @map("order_id") @db.Uuid
  carrier         String?        @db.VarChar(100)
  trackingNumber  String?        @map("tracking_number") @db.VarChar(160)
  status          ShipmentStatus @default(PENDING)
  shippedAt       DateTime?      @map("shipped_at") @db.Timestamptz(6)
  deliveredAt     DateTime?      @map("delivered_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([businessId, status, createdAt])
  @@index([orderId])
  @@map("shipments")
}

model Notification {
  id          String             @id @default(uuid()) @db.Uuid
  businessId  String             @map("business_id") @db.Uuid
  recipient   String             @db.VarChar(320)
  channel     NotificationChannel
  templateKey String             @map("template_key") @db.VarChar(100)
  subject     String?            @db.VarChar(200)
  payload     Json               @default("{}")
  status      NotificationStatus @default(QUEUED)
  attempts    Int                @default(0)
  lastError   String?            @map("last_error") @db.Text
  scheduledAt DateTime?          @map("scheduled_at") @db.Timestamptz(6)
  sentAt      DateTime?          @map("sent_at") @db.Timestamptz(6)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status, scheduledAt])
  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(120)
  entityType  String   @map("entity_type") @db.VarChar(100)
  entityId    String?  @map("entity_id") @db.VarChar(100)
  metadata    Json     @default("{}")
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([businessId, entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model ProductDailyMetric {
  id              String   @id @default(uuid()) @db.Uuid
  businessId      String   @map("business_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  metricDate      DateTime @map("metric_date") @db.Date
  unitsSold       Decimal  @default(0) @map("units_sold") @db.Decimal(12, 3)
  grossRevenue    Decimal  @default(0) @map("gross_revenue") @db.Decimal(14, 2)
  unitsReturned   Decimal  @default(0) @map("units_returned") @db.Decimal(12, 3)
  stockoutMinutes Int      @default(0) @map("stockout_minutes")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([businessId, productId, metricDate])
  @@index([businessId, metricDate])
  @@map("product_daily_metrics")
}

model ForecastRun {
  id           String           @id @default(uuid()) @db.Uuid
  businessId   String           @map("business_id") @db.Uuid
  modelName    String           @map("model_name") @db.VarChar(120)
  modelVersion String           @map("model_version") @db.VarChar(80)
  periodStart  DateTime         @map("period_start") @db.Date
  periodEnd    DateTime         @map("period_end") @db.Date
  horizonDays  Int              @default(30) @map("horizon_days")
  status       ForecastRunStatus @default(QUEUED)
  metrics      Json             @default("{}")
  errorMessage String?          @map("error_message") @db.Text
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt  DateTime?        @map("completed_at") @db.Timestamptz(6)
  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  forecasts    DemandForecast[]

  @@index([businessId, status, createdAt])
  @@map("forecast_runs")
}

model DemandForecast {
  id               String      @id @default(uuid()) @db.Uuid
  forecastRunId    String      @map("forecast_run_id") @db.Uuid
  productId        String      @map("product_id") @db.Uuid
  targetDate       DateTime    @map("target_date") @db.Date
  predictedQuantity Decimal    @map("predicted_quantity") @db.Decimal(12, 3)
  lowerBound       Decimal?    @map("lower_bound") @db.Decimal(12, 3)
  upperBound       Decimal?    @map("upper_bound") @db.Decimal(12, 3)
  explanation      Json        @default("{}")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  forecastRun      ForecastRun @relation(fields: [forecastRunId], references: [id], onDelete: Cascade)
  product          Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([forecastRunId, productId, targetDate])
  @@index([productId, targetDate])
  @@map("demand_forecasts")
}

model BusinessSetting {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  key        String   @db.VarChar(120)
  value      Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, key])
  @@map("business_settings")
}
